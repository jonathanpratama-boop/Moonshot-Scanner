# Variable names only. Copy to .env and fill in what you need; .env is git-ignored.
# Nothing here is required for the sample demonstration or the tests.

# --- storage / operation
ASTRA_DB=
ASTRA_OUTBOX_DIR=
ASTRA_WORKER_ID=
ASTRA_DISPLAY_TIMEZONES=
ASTRA_LEASE_SECONDS=
ASTRA_DEFAULT_EXPIRY_SESSIONS=
ASTRA_NON_SIGNAL_SAMPLES=

# --- SEC EDGAR (free; identification required by SEC before any request is sent)
ASTRA_SEC_USER_AGENT=
ASTRA_SEC_MAX_ISSUERS=
ASTRA_SEC_MIN_INTERVAL_SECONDS=
ASTRA_SEC_TIMEOUT_SECONDS=
ASTRA_SEC_MAX_RETRIES=

# --- OPTIONAL paid AI researcher (disabled unless ASTRA_AI_PAID_CALLS is explicitly set to enable it)
ASTRA_AI_PAID_CALLS=
ASTRA_AI_PROVIDER=
ASTRA_AI_MODEL=
ASTRA_AI_EFFORT=
ASTRA_AI_FALLBACKS=
ASTRA_AI_MAX_OUTPUT_TOKENS=
ASTRA_AI_MAX_CALLS_PER_RUN=
ASTRA_AI_MAX_CALLS_PER_DAY=
ASTRA_AI_MAX_INPUT_CHARS=
ASTRA_AI_TIMEOUT_SECONDS=
ASTRA_AI_MAX_RETRIES=
ANTHROPIC_API_KEY=
